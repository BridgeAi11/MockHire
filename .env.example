# =============================================================
# MockHire Environment Configuration
# =============================================================

# Supabase Public Configuration (Browser accessible)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Server-Only Secret Role Key (Never exposed to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# PostgreSQL Direct Connection URI
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# Application Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_WEBCAM=true
